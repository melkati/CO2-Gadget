            !(function () {
	var pageIdList = {
		0: 'bgpc_detail', // 普通
		1: 'bgpc_detail_groupshopping', // 拼团
		2: 'bgpc_snap_detail', // 秒杀
		3: 'bgpc_detail_deposit', // 定金预售
	}
	// free gift单独模板 bgpc_newuser_zone_gift_detail
	var pageId = pageIdList[0]
	var url = location.href
	if (url.indexOf('/groupshopping-item') > -1) {
		pageId = pageIdList[1]
	} else if (url.indexOf('/snapup/') > -1) {
		pageId = pageIdList[2]
	} else if (url.indexOf('deposit=1') > -1) {
		pageId = pageIdList[3]
	}
	window.spm_page_id = pageId
}())
