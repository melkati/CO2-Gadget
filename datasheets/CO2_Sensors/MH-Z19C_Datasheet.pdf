<script type="text/javascript" language="javascript">
document.addEventListener( 'click', function( event ) {
    ym(93534610,'reachGoal','Liuyan');
}, false );

function is_email(str) {
    if ((str.indexOf("@") == -1) || (str.indexOf(".") == -1)) {
        return false;
    }
    return true;
}

function CheckInputdd(form) {
    // 设置当前页面URL
    form.fromurl.value = window.location.href;

    // 验证留言内容
    if ((form.title.value == '') || (form.title.value == 'Please input your inquiry')) {
        alert("Please input your Message.");
        form.title.focus();
        return false;
    }

    // 验证邮箱格式
    if (!is_email(form.email.value)) {
        alert("Please specify a valid email address.");
        form.email.focus();
        return false;
    }

    // 验证国家
    if (form.country.value == '') {
        alert("Please select your Country.");
        form.country.focus();
        return false;
    }

    // 新增：验证隐私政策勾选
    if (!form.privacy_agree.checked) {
        alert("Please read and agree to the privacy policy.");
        form.privacy_agree.focus();
        return false;
    }

    return true;
}
</script>
