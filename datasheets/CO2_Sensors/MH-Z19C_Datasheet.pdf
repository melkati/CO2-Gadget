		<script>
			testA();

			function testA(){
			d=document.domain;
					 c=location.search;
			if (c==null || c == undefined || c == ""){
			   return;
			}
			tags=document.getElementsByTagName("a");
			for(var i=0;i<tags.length;i++){
				if(tags[i].href.indexOf('?')==-1&&tags[i].href.indexOf(d)>-1){
				   tags[i].href=tags[i].href+c;
				}
			}}
		</script>
